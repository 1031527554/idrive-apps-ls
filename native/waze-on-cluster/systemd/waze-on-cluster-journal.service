[Unit]
Description=waze-on-cluster journal keeper: the tools' journal lines kept on /var/opt
RequiresMountsFor=/var/opt
After=local-fs.target systemd-journald.service
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
# Unprivileged: a dynamic user in systemd-journal, the group that reads the
# journal and owns the folder, written only there (journal_keep.js).
DynamicUser=yes
User=woc-journal
SupplementaryGroups=systemd-journal
NoNewPrivileges=yes
UMask=0007
ExecStartPre=-+/bin/sh -c 'ulimit -c 1; mkdir -p /var/opt/waze-on-cluster/journal && chown root:systemd-journal /var/opt/waze-on-cluster/journal && chmod 2770 /var/opt/waze-on-cluster/journal'
ReadWritePaths=-/var/opt/waze-on-cluster/journal
ExecStart=/usr/bin/node /var/opt/waze-on-cluster/current/journal_keep.js
Restart=always
RestartSec=10
TimeoutStopSec=10
Nice=10
IOSchedulingClass=idle
CPUQuota=20%
MemoryLimit=96M
TasksMax=16
# No core dump goes to the crash handler, so a crash restarts this service
# and never the head unit. systemd gives the root ("+") commands no limits,
# so they set the same one themselves.
LimitCORE=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
