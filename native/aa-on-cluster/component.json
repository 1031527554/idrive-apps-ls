{
  "id": "aa-on-cluster",
  "kind": "tool",
  "version": "0.7.0",
  "license": "GPL-3.0-or-later",
  "title": "Android Auto on cluster",
  "description": "Shows Google Maps' Android Auto instrument-cluster view in the cluster's map area: reversible edits to aapd and its cluster geometry, drawn by waze-on-cluster's capture, with a recovery that restores stock aapd by itself if it ever crashes. By mlurker@gmail.com",
  "requires": {
    "mgu-deploy": "0.7.0",
    "waze-on-cluster": "0.7.10"
  },
  "uninstallable": true,
  "mguHmi": [
    "ID7"
  ],
  "activate": [
    "node",
    "aoc.js",
    "activate"
  ],
  "deactivate": [
    "node",
    "aoc.js",
    "deactivate"
  ],
  "files": [
    { "path": "aoc.js", "from": "patch/aoc.js", "mode": "0644" },
    { "path": "aoc_files.js", "from": "patch/aoc_files.js", "mode": "0644" },
    { "path": "aapd_patch.js", "from": "patch/aapd_patch.js", "mode": "0644" },
    { "path": "aapd_conf.js", "from": "patch/aapd_conf.js", "mode": "0644" },
    { "path": "recovery.js", "from": "patch/recovery.js", "mode": "0644" },
    { "path": "remount_lock.js", "from": "patch/remount_lock.js", "mode": "0644" },
    { "path": "LICENSE", "from": "LICENSE", "mode": "0644" }
  ],
  "units": [
    { "name": "aa-on-cluster-boot.service", "from": "systemd/aa-on-cluster-boot.service" },
    { "name": "aa-on-cluster-recovery.service", "from": "systemd/aa-on-cluster-recovery.service" },
    { "name": "aa-on-cluster-ctl.service", "from": "systemd/aa-on-cluster-ctl.service" }
  ],
  "enable": [
    { "unit": "aa-on-cluster-boot.service", "target": "multi-user.target" },
    { "unit": "aa-on-cluster-recovery.service", "target": "multi-user.target" },
    { "unit": "aa-on-cluster-ctl.service", "target": "multi-user.target" }
  ],
  "crashNames": ["aapd"],
  "recmgr": [
    "aapd",
    "aa-on-cluster-boot",
    "aa-on-cluster-recovery",
    "aa-on-cluster-ctl"
  ],
  "restart": [
    "aa-on-cluster-boot.service",
    "aa-on-cluster-recovery.service",
    "aa-on-cluster-ctl.service"
  ]
}
