[Unit]
Description=aa-on-cluster boot check: restore stock aapd before it starts if the cluster edits crash it
RequiresMountsFor=/var/opt
After=local-fs.target
# aapd.service (WantedBy=late.target) and waze-on-cluster start once this
# has finished, failed or timed out; they do not require it.
Before=aapd.service waze-on-cluster.service waze-on-cluster-capture.service

[Service]
# Root: at the threshold it remounts / read-write only for the verified revert
# (recovery.js), then read-only again. Otherwise it reads its record and exits.
Type=oneshot
RemainAfterExit=yes
ExecStart=-/usr/bin/node /var/opt/aa-on-cluster/current/recovery.js boot
TimeoutStartSec=90
TimeoutStopSec=90
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
